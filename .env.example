# Copy to .env and fill in. Never commit the real .env.

# Required — Groq API key for the LLM (get one free at https://console.groq.com)
GROQ_API_KEY=

# Retrieval backend: "memory" (in-process, no infra), "elasticsearch" (needs infra),
# or "upstash" (serverless, server-side embeddings — used for the Vercel deploy)
BACKEND=memory

# Only used when BACKEND=upstash (create a HYBRID index in the Upstash console):
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# Only used when BACKEND=elasticsearch:
ES_URL=http://localhost:9200
ES_INDEX=askable
REDIS_URL=redis://localhost:6379

# Deployed frontend origin for CORS (e.g. https://askable.vercel.app). Optional in dev.
FRONTEND_ORIGIN=

# Optional — swap the embedding model (must be 384-dim to match the index)
# EMBEDDING_MODEL=all-MiniLM-L6-v2
